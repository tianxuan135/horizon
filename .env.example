# =============================================================================
# Horizon 极目楚天 · 环境变量示例
# -----------------------------------------------------------------------------
# 用法：
#   1) 复制本文件为仓库根目录下的 .env
#        Windows PowerShell:  Copy-Item .env.example .env
#        macOS / Linux:       cp .env.example .env
#   2) 按需填写。所有密钥只存在于 .env / 部署平台的 Secret 中。
#   3) Docker Compose 从仓库根目录读取 .env：
#        docker compose --env-file .env -f infra/docker-compose.yml up -d
#
# ⚠️  切勿把 .env 提交到公开仓库。
#     本文件所有值均为空或安全默认值，不含任何真实凭据。
#
# 说明：后端使用 pydantic-settings，变量名与 api/app/config.py 字段同名大写，
#       没有额外前缀（例如字段 smtp_host 对应 SMTP_HOST，而不是 HORIZON_SMTP_HOST）。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 运行环境
# -----------------------------------------------------------------------------
# 运行模式：development | production
# 生产环境请设为 production，并务必显式设置 JWT_SECRET（见下文）。
# 注意：POSIX shell 自身也使用名为 ENV 的变量，请确保通过本文件注入而非 shell export。
ENV=development

# API 监听地址与端口。容器内必须为 0.0.0.0，否则容器外不可达。
API_HOST=0.0.0.0
API_PORT=8000

# 允许跨域访问的前端源，多个用英文逗号分隔。
# 通过 nginx / Next.js 同源访问时通常无需修改；本地开发默认如下。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 2. 数据存储
# -----------------------------------------------------------------------------
# 数据库连接串。
# 本地开发默认使用 SQLite（开箱即用、零依赖，文件生成在启动目录）：
DATABASE_URL=sqlite:///./horizon.db
# Docker Compose（PostgreSQL 16 + TimescaleDB）示例，密码通过变量注入，不要写死：
# DATABASE_URL=postgresql+psycopg://horizon:__POSTGRES_PASSWORD__@postgres:5432/horizon

# Redis 连接串（可留空）。留空时仅使用进程内 TTL 缓存，单机完全可用。
# 多副本部署 / 需要共享缓存时再启用：
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# -----------------------------------------------------------------------------
# 3. 数据源开关与凭据（全部可选；缺失时自动降级并如实上报 source）
# -----------------------------------------------------------------------------
# Yahoo Finance 公开图表接口：true / false
# 个人研究用途，请遵守上游服务条款与频率限制。默认开启。
YAHOO_ENABLED=true

# AKShare（MIT 开源，A 股数据）：true / false
# 未在环境中安装 akshare 库时，该源会自动标记为不可用并降级。
AKSHARE_ENABLED=true

# Tushare Token（可选，A 股。需要自行注册并遵守其积分/授权规则）
# 留空即不启用；严禁把已付费额度或企业凭据提交到公开仓库。
TUSHARE_TOKEN=

# Finnhub API Key（可选，美股基本面/新闻）
# 留空即不启用。
FINNHUB_KEY=

# -----------------------------------------------------------------------------
# 4. 认证与安全
# -----------------------------------------------------------------------------
# 是否启用账号体系：true / false
# 设为 false 时前端以匿名只读方式使用（自建私有实例常见选择）。
AUTH_ENABLED=false

# JWT 签名密钥。生产环境必须显式设置为足够长的随机串，否则服务会在每次重启后
# 随机生成新密钥，导致所有已签发 Token 立即失效。
# 留空 = 开发模式自动随机生成（仅限本地）。
# 生成方式见 README「部署前检查清单」。
JWT_SECRET=

# 登录 Token 有效期（小时）。默认 72。
TOKEN_TTL_HOURS=72

# -----------------------------------------------------------------------------
# 5. 邮件验证码（可选）
# -----------------------------------------------------------------------------
# 仅当 SMTP_HOST 非空时，注册流程才会要求邮箱验证码（requiresVerification=true）。
# 全部留空 = 关闭邮件验证，注册后直接可用。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址（占位默认值，无需真实邮箱即可运行）
SMTP_FROM=no-reply@horizon.local

# -----------------------------------------------------------------------------
# 6. 服务间通信
# -----------------------------------------------------------------------------
# Next.js 服务端把 /api/v1/* 转发到该地址（BFF 代理目标）。
# 本地开发：http://127.0.0.1:8000
# Docker Compose：http://api:8000
API_INTERNAL_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 7. Docker Compose 专用（本地开发 / 自建部署）
# -----------------------------------------------------------------------------
# PostgreSQL 初始库名与用户名
POSTGRES_DB=horizon
POSTGRES_USER=horizon
# 数据库密码：请改成你自己的强随机值。此处的默认值仅为占位，切勿用于公网部署。
POSTGRES_PASSWORD=change_me_before_deploy

# 对外暴露的端口（nginx 统一入口）
NGINX_PORT=80
# api / web 在宿主机上的绑定端口（compose 已固定绑定 127.0.0.1，仅供本机调试；
# 对外访问一律走 nginx，见 NGINX_PORT）。变量名需与 infra/docker-compose.yml 保持一致。
# API_PUBLISHED_PORT=8000
# WEB_PUBLISHED_PORT=3000