node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

.next/
out/
build/
dist/
.turbo/
.swc/
.vercel/
next-env.d.ts
*.tsbuildinfo
.eslintcache
.cache/
storybook-static/

