*.db-journal
*.db-wal
*.sqlite3
horizon.db
*.log
pip.log

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 版本控制与编辑器
.git/
.gitignore
.vscode/
.idea/

# 文档与容器文件本身
*.md
Dockerfile
.dockerignore